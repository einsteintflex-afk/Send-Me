ENV=development
DATABASE_URL=postgresql+psycopg://sendme:sendme@localhost:5432/sendme
JWT_SECRET=change-me-to-a-long-random-string
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
UPLOAD_DIR=./uploads
# Paystack: leave blank until you have keys. Payments return 503 until set.
PAYSTACK_SECRET_KEY=
# Optional seed values (python -m app.seed)
SEED_UNIVERSITY=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_PHONE=
